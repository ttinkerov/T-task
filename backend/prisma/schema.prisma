generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TeamSize {
  SOLO
  SMALL
  MEDIUM
  LARGE
}

enum WorkspaceUseCase {
  DEVELOPMENT
  DESIGN
  MARKETING
  PRODUCT
  OPERATIONS
  OTHER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskRecurrenceRule {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum TaskRecurrenceAction {
  DUPLICATE
  RESCHEDULE
}

enum TaskRelationType {
  BLOCKS
  RELATES_TO
}

enum NotificationType {
  MENTION
  DUE_REMINDER
  WATCH
}

enum SavedFilterView {
  BOARD
  ALL_TASKS
  MY_TASKS
}

enum MentionSourceType {
  TASK_DESCRIPTION
  COMMENT
}

enum ColumnAutomationAction {
  ASSIGN_USER
  START_TIMER
  COMPLETE_TASK
}

enum ExternalAppProvider {
  GOOGLE_DOCS
  GOOGLE_SHEETS
  FIGMA
  MIRO
  AIRTABLE
}

enum AiProvider {
  OPENAI
  OPENROUTER
  GROQ
  CUSTOM
}

enum FormFieldType {
  SHORT_TEXT
  LONG_TEXT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  sessions            RefreshSession[]
  memberships         WorkspaceMember[]
  sentInvitations     Invitation[]           @relation("InvitationInviter")
  assignedTasks       Task[]                 @relation("TaskAssignee")
  assignedDeals       Deal[]                 @relation("DealAssignee")
  columnAutomations   ColumnAutomation[]     @relation("ColumnAutomationAssignee")
  createdExternalApps WorkspaceExternalApp[] @relation("ExternalAppCreator")
  calendarFeeds       CalendarFeed[]
  comments            Comment[]
  receivedNotifications Notification[]       @relation("NotificationRecipient")
  sentNotifications     Notification[]       @relation("NotificationActor")
  savedFilters          SavedFilter[]
  watchedTasks          TaskWatcher[]
  whiteboardUpdates     WorkspaceWhiteboard[] @relation("WhiteboardUpdater")

  @@map("users")
}

model RefreshSession {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  familyId   String    @map("family_id")
  deviceInfo Json?     @map("device_info")
  ipAddress  String?   @map("ip_address")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_sessions")
}

model Workspace {
  id              String             @id @default(cuid())
  name            String
  slug            String             @unique
  ownerId         String             @map("owner_id")
  teamSize        TeamSize?          @map("team_size")
  useCases        WorkspaceUseCase[] @default([]) @map("use_cases")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  archivedAt      DateTime?          @map("archived_at")
  deletedAt       DateTime?          @map("deleted_at")
  autoRollOverdue Boolean            @default(false) @map("auto_roll_overdue")

  members      WorkspaceMember[]
  invitations  Invitation[]
  boards       Board[]
  funnels      Funnel[]
  forms        Form[]
  externalApps WorkspaceExternalApp[]
  calendarFeeds CalendarFeed[]
  customFields CustomFieldDefinition[]
  tags         Tag[]
  savedFilters SavedFilter[]
  activityLogs ActivityLog[]
  notifications Notification[]
  aiSetting     AiWorkspaceSetting?
  whiteboard    WorkspaceWhiteboard?
  sprints       Sprint[]
  dodTemplates  DodTemplate[]
  taskTemplates TaskTemplate[]
  dealTemplates DealTemplate[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole
  scopes      String[]      @default([])
  joinedAt    DateTime      @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model CalendarFeed {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  userId      String    @map("user_id")
  tokenHash   String    @unique @map("token_hash")
  tokenPrefix String    @map("token_prefix")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  revokedAt   DateTime? @map("revoked_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("calendar_feeds")
}

model Invitation {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  invitedById String        @map("invited_by")
  email       String
  role        WorkspaceRole @default(MEMBER)
  tokenHash   String        @unique @map("token_hash")
  expiresAt   DateTime      @map("expires_at")
  acceptedAt  DateTime?     @map("accepted_at")
  revokedAt   DateTime?     @map("revoked_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@map("invitations")
}

model Board {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String   @default("Доска")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  columns   BoardColumn[]

  @@index([workspaceId])
  @@map("boards")
}

model BoardColumn {
  id        String    @id @default(cuid())
  boardId   String    @map("board_id")
  name      String
  position  Int
  wipLimit  Int?      @map("wip_limit")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  board       Board              @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks       Task[]
  automations ColumnAutomation[]

  @@index([boardId])
  @@index([boardId, deletedAt])
  @@map("board_columns")
}

model Task {
  id                       String               @id @default(cuid())
  columnId                 String               @map("column_id")
  title                    String
  description              String?
  descriptionDoc           Json?                @map("description_doc")
  priority                 TaskPriority?
  complexity               Int?
  timeEstimateMinutes      Int?                 @map("time_estimate_minutes")
  actualMinutes            Int?                 @map("actual_minutes")
  dueDate                  DateTime?            @map("due_date")
  assigneeId               String?              @map("assignee_id")
  position                 Int
  recurrenceRule           TaskRecurrenceRule   @default(NONE) @map("recurrence_rule")
  recurrenceAction         TaskRecurrenceAction @default(DUPLICATE) @map("recurrence_action")
  recurrenceWeekdays       Int[]                @default([]) @map("recurrence_weekdays")
  recurrenceOriginColumnId String?              @map("recurrence_origin_column_id")
  overdueDays              Int                  @default(0) @map("overdue_days")
  timerStartedAt           DateTime?            @map("timer_started_at")
  completedAt              DateTime?            @map("completed_at")
  dueReminderSentAt        DateTime?            @map("due_reminder_sent_at")
  sprintId                 String?              @map("sprint_id")
  isEpic                   Boolean              @default(false) @map("is_epic")
  epicId                   String?              @map("epic_id")
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")
  deletedAt                DateTime?            @map("deleted_at")

  column   BoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignee User?       @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  sprint   Sprint?     @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  epic     Task?       @relation("TaskEpic", fields: [epicId], references: [id], onDelete: SetNull)
  children Task[]      @relation("TaskEpic")
  comments Comment[]
  outgoingRelations TaskRelation[] @relation("TaskRelationSource")
  incomingRelations TaskRelation[] @relation("TaskRelationTarget")
  customFieldValues CustomFieldValue[]
  notifications Notification[]
  taskTags TaskTag[]
  subtasks Subtask[]
  checklistItems TaskChecklistItem[]
  attachments TaskAttachment[]
  dealLinks DealTask[]
  watchers TaskWatcher[]

  @@index([columnId])
  @@index([columnId, deletedAt])
  @@index([columnId, deletedAt, position])
  @@index([assigneeId])
  @@index([assigneeId, dueDate])
  @@index([deletedAt])
  @@index([dueDate])
  @@index([completedAt])
  @@index([updatedAt])
  @@index([sprintId])
  @@index([epicId])
  @@map("tasks")
}

model DodTemplate {
  id              String            @id @default(cuid())
  workspaceId     String            @map("workspace_id")
  name            String
  gatesCompletion Boolean           @default(true) @map("gates_completion")
  position        Int
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items     DodTemplateItem[]

  @@index([workspaceId])
  @@map("dod_templates")
}

model DodTemplateItem {
  id         String @id @default(cuid())
  templateId String @map("template_id")
  text       String
  position   Int

  template DodTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@map("dod_template_items")
}

model TaskTemplate {
  id                    String        @id @default(cuid())
  workspaceId           String        @map("workspace_id")
  name                  String
  title                 String?
  description           String?
  priority              TaskPriority?
  complexity            Int?
  timeEstimateMinutes   Int?          @map("time_estimate_minutes")
  checklistGates        Boolean       @default(true) @map("checklist_gates")
  tagIds                String[]      @default([]) @map("tag_ids")
  subtaskTitles         String[]      @default([]) @map("subtask_titles")
  checklistItems        String[]      @default([]) @map("checklist_items")
  position              Int
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("task_templates")
}

model DealTemplate {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  title       String?
  description String?
  amount      Int?
  contactName String?  @map("contact_name")
  companyName String?  @map("company_name")
  position    Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("deal_templates")
}

model TaskChecklistItem {
  id               String   @id @default(cuid())
  taskId           String   @map("task_id")
  text             String
  completed        Boolean  @default(false)
  required         Boolean  @default(true)
  position         Int
  sourceTemplateId String?  @map("source_template_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_checklist_items")
}

model Sprint {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  name        String
  startDate   DateTime  @map("start_date")
  endDate     DateTime  @map("end_date")
  closedAt    DateTime? @map("closed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([workspaceId])
  @@map("sprints")
}

model TaskWatcher {
  taskId    String   @map("task_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_watchers")
}

model Tag {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  color       String   @default("#3B82F6")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     TaskTag[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("tags")
}

model TaskTag {
  taskId String @map("task_id")
  tagId  String @map("tag_id")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
  @@map("task_tags")
}

model Subtask {
  id        String    @id @default(cuid())
  taskId    String    @map("task_id")
  title     String
  completed Boolean   @default(false)
  position  Int
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("subtasks")
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  CHECKBOX
  SELECT
  MULTI_SELECT
  URL
  USER
}

model CustomFieldDefinition {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  name        String
  type        CustomFieldType
  options     String[]        @default([])
  showOnCard  Boolean         @default(false) @map("show_on_card")
  position    Int
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  values    CustomFieldValue[]

  @@index([workspaceId])
  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id        String   @id @default(cuid())
  fieldId   String   @map("field_id")
  taskId    String   @map("task_id")
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  field CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  task  Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([fieldId, taskId])
  @@index([taskId])
  @@map("custom_field_values")
}

model TaskRelation {
  id           String           @id @default(cuid())
  sourceTaskId String           @map("source_task_id")
  targetTaskId String           @map("target_task_id")
  pairKey      String           @unique @map("pair_key")
  type         TaskRelationType
  createdAt    DateTime         @default(now()) @map("created_at")

  sourceTask Task @relation("TaskRelationSource", fields: [sourceTaskId], references: [id], onDelete: Cascade)
  targetTask Task @relation("TaskRelationTarget", fields: [targetTaskId], references: [id], onDelete: Cascade)

  @@index([sourceTaskId])
  @@index([targetTaskId])
  @@map("task_relations")
}

model ColumnAutomation {
  id         String                 @id @default(cuid())
  columnId   String                 @map("column_id")
  action     ColumnAutomationAction
  assigneeId String?                @map("assignee_id")
  position   Int                    @default(0)
  createdAt  DateTime               @default(now()) @map("created_at")
  updatedAt  DateTime               @updatedAt @map("updated_at")

  column   BoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignee User?       @relation("ColumnAutomationAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@unique([columnId, action])
  @@index([columnId])
  @@index([assigneeId])
  @@map("column_automations")
}

model WorkspaceExternalApp {
  id          String              @id @default(cuid())
  workspaceId String              @map("workspace_id")
  createdById String?             @map("created_by_id")
  provider    ExternalAppProvider
  title       String
  sourceUrl   String              @map("source_url")
  embedUrl    String              @map("embed_url")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  deletedAt   DateTime?           @map("deleted_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("ExternalAppCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([createdById])
  @@index([workspaceId, deletedAt])
  @@map("workspace_external_apps")
}

model ActivityLog {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  // Plain snapshot id — no User FK, so actor deletion cannot erase history.
  actorId     String?  @map("actor_id")
  actorName   String   @map("actor_name")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  entityName  String?  @map("entity_name")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  // Restrict: hard-deleting a workspace must not silently wipe the audit trail.
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([actorId])
  @@index([workspaceId, action])
  @@map("activity_logs")
}

model Funnel {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String   @default("Продажи")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    FunnelStage[]

  @@index([workspaceId])
  @@map("funnels")
}

model FunnelStage {
  id        String    @id @default(cuid())
  funnelId  String    @map("funnel_id")
  name      String
  position  Int
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  funnel Funnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  deals  Deal[]

  @@index([funnelId])
  @@map("funnel_stages")
}

model Deal {
  id          String   @id @default(cuid())
  stageId     String   @map("stage_id")
  title       String
  description String?
  amount      Int?
  contactName String?  @map("contact_name")
  companyName String?  @map("company_name")
  assigneeId  String?  @map("assignee_id")
  position    Int
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  stage    FunnelStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  assignee User?       @relation("DealAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  taskLinks DealTask[]

  @@index([stageId])
  @@index([stageId, deletedAt, position])
  @@index([assigneeId])
  @@index([deletedAt])
  @@map("deals")
}

model DealTask {
  dealId    String   @map("deal_id")
  taskId    String   @map("task_id")
  createdAt DateTime @default(now()) @map("created_at")

  deal Deal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([dealId, taskId])
  @@index([taskId])
  @@map("deal_tasks")
}

model SavedFilter {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  userId      String          @map("user_id")
  view        SavedFilterView
  name        String
  filters     Json
  isDefault   Boolean         @default(false) @map("is_default")
  isShared    Boolean         @default(false) @map("is_shared")
  isPinned    Boolean         @default(false) @map("is_pinned")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, view])
  @@index([workspaceId, isShared])
  @@map("saved_filters")
}

model TaskAttachment {
  id           String   @id @default(cuid())
  taskId       String   @map("task_id")
  uploadedById String?  @map("uploaded_by_id")
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  storagePath  String   @map("storage_path")
  createdAt    DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_attachments")
}

model Form {
  id                 String   @id @default(cuid())
  workspaceId        String   @map("workspace_id")
  title              String
  description        String?
  publicToken        String   @unique @map("public_token")
  isPublic           Boolean  @default(true) @map("is_public")
  createTaskOnSubmit Boolean  @default(false) @map("create_task_on_submit")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fields    FormField[]
  responses FormResponse[]

  @@index([workspaceId])
  @@map("forms")
}

model FormField {
  id        String        @id @default(cuid())
  formId    String        @map("form_id")
  type      FormFieldType
  label     String
  options   String[]      @default([])
  required  Boolean       @default(false)
  position  Int
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("form_fields")
}

model FormResponse {
  id        String   @id @default(cuid())
  formId    String   @map("form_id")
  answers   Json
  createdAt DateTime @default(now()) @map("created_at")

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("form_responses")
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  authorId  String   @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([taskId])
  @@index([authorId])
  @@map("comments")
}

model Notification {
  id          String             @id @default(cuid())
  workspaceId String             @map("workspace_id")
  recipientId String             @map("recipient_id")
  actorId     String?            @map("actor_id")
  taskId      String             @map("task_id")
  commentId   String?            @map("comment_id")
  type        NotificationType   @default(MENTION)
  sourceType  MentionSourceType? @map("source_type")
  preview     String
  readAt      DateTime?          @map("read_at")
  createdAt   DateTime           @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  recipient User      @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment   Comment?  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([workspaceId, recipientId, readAt, createdAt])
  @@index([taskId])
  @@index([recipientId, commentId])
  @@map("notifications")
}

model AiWorkspaceSetting {
  id              String     @id @default(cuid())
  workspaceId     String     @unique @map("workspace_id")
  provider        AiProvider @default(OPENAI)
  baseUrl         String?    @map("base_url")
  model           String
  tokenCiphertext String     @map("token_ciphertext")
  tokenIv         String     @map("token_iv")
  tokenAuthTag    String     @map("token_auth_tag")
  tokenLast4      String     @map("token_last4")
  createdById     String?    @map("created_by_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("ai_workspace_settings")
}

/** Solo tldraw canvas snapshot per workspace (document only; no realtime). */
model WorkspaceWhiteboard {
  id          String   @id @default(cuid())
  workspaceId String   @unique @map("workspace_id")
  snapshot    Json     @default("{}")
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  updatedBy User?     @relation("WhiteboardUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
  @@map("workspace_whiteboards")
}
