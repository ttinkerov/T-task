generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum TeamSize {
  SOLO
  SMALL
  MEDIUM
  LARGE
}

enum WorkspaceUseCase {
  DEVELOPMENT
  DESIGN
  MARKETING
  PRODUCT
  OPERATIONS
  OTHER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskRecurrenceRule {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum TaskRecurrenceAction {
  DUPLICATE
  RESCHEDULE
}

enum FormFieldType {
  SHORT_TEXT
  LONG_TEXT
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  sessions         RefreshSession[]
  memberships      WorkspaceMember[]
  sentInvitations  Invitation[]     @relation("InvitationInviter")
  assignedTasks    Task[]           @relation("TaskAssignee")
  assignedDeals    Deal[]           @relation("DealAssignee")
  comments         Comment[]

  @@map("users")
}

model RefreshSession {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  familyId   String    @map("family_id")
  deviceInfo Json?     @map("device_info")
  ipAddress  String?   @map("ip_address")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_sessions")
}

model Workspace {
  id         String             @id @default(cuid())
  name       String
  slug       String             @unique
  ownerId    String             @map("owner_id")
  teamSize   TeamSize?          @map("team_size")
  useCases   WorkspaceUseCase[] @default([]) @map("use_cases")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  archivedAt DateTime?          @map("archived_at")
  deletedAt  DateTime?          @map("deleted_at")
  autoRollOverdue Boolean       @default(false) @map("auto_roll_overdue")

  members     WorkspaceMember[]
  invitations Invitation[]
  boards      Board[]
  funnels     Funnel[]
  forms       Form[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  userId      String        @map("user_id")
  role        WorkspaceRole
  joinedAt    DateTime      @default(now()) @map("joined_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Invitation {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  invitedById String        @map("invited_by")
  email       String
  role        WorkspaceRole @default(MEMBER)
  tokenHash   String        @unique @map("token_hash")
  expiresAt   DateTime      @map("expires_at")
  acceptedAt  DateTime?     @map("accepted_at")
  revokedAt   DateTime?     @map("revoked_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@map("invitations")
}

model Board {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String   @default("Доска")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  columns   BoardColumn[]

  @@index([workspaceId])
  @@map("boards")
}

model BoardColumn {
  id        String   @id @default(cuid())
  boardId   String   @map("board_id")
  name      String
  position  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([boardId])
  @@map("board_columns")
}

model Task {
  id          String        @id @default(cuid())
  columnId    String        @map("column_id")
  title       String
  description String?
  priority    TaskPriority?
  complexity  Int?
  timeEstimateMinutes Int? @map("time_estimate_minutes")
  actualMinutes       Int? @map("actual_minutes")
  dueDate     DateTime?     @map("due_date")
  assigneeId  String?       @map("assignee_id")
  position    Int
  recurrenceRule TaskRecurrenceRule @default(NONE) @map("recurrence_rule")
  recurrenceAction TaskRecurrenceAction @default(DUPLICATE) @map("recurrence_action")
  recurrenceWeekdays Int[] @default([]) @map("recurrence_weekdays")
  recurrenceOriginColumnId String? @map("recurrence_origin_column_id")
  overdueDays Int             @default(0) @map("overdue_days")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  column   BoardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  assignee User?       @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments Comment[]

  @@index([columnId])
  @@index([assigneeId])
  @@map("tasks")
}

model Funnel {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String   @default("Продажи")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    FunnelStage[]

  @@index([workspaceId])
  @@map("funnels")
}

model FunnelStage {
  id        String   @id @default(cuid())
  funnelId  String   @map("funnel_id")
  name      String
  position  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  funnel Funnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  deals  Deal[]

  @@index([funnelId])
  @@map("funnel_stages")
}

model Deal {
  id          String   @id @default(cuid())
  stageId     String   @map("stage_id")
  title       String
  description String?
  amount      Int?
  contactName String?  @map("contact_name")
  companyName String?  @map("company_name")
  assigneeId  String?  @map("assignee_id")
  position    Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  stage    FunnelStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  assignee User?       @relation("DealAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([stageId])
  @@index([assigneeId])
  @@map("deals")
}

model Form {
  id                 String   @id @default(cuid())
  workspaceId        String   @map("workspace_id")
  title              String
  description        String?
  publicToken        String   @unique @map("public_token")
  isPublic           Boolean  @default(true) @map("is_public")
  createTaskOnSubmit Boolean  @default(false) @map("create_task_on_submit")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fields    FormField[]
  responses FormResponse[]

  @@index([workspaceId])
  @@map("forms")
}

model FormField {
  id       String        @id @default(cuid())
  formId   String        @map("form_id")
  type     FormFieldType
  label    String
  options  String[]      @default([])
  required Boolean       @default(false)
  position Int
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("form_fields")
}

model FormResponse {
  id        String   @id @default(cuid())
  formId    String   @map("form_id")
  answers   Json
  createdAt DateTime @default(now()) @map("created_at")

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@map("form_responses")
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  authorId  String   @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([authorId])
  @@map("comments")
}
