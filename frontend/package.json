{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "copy:tldraw-assets": "node ./scripts/copy-tldraw-assets.mjs",
    "postinstall": "node ./scripts/copy-tldraw-assets.mjs",
    "dev": "node ./scripts/copy-tldraw-assets.mjs && next dev --port 3000",
    "build": "node ./scripts/copy-tldraw-assets.mjs && next build",
    "start": "next start --port 3000",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test e2e/smoke.spec.ts",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.80.6",
    "@tanstack/react-virtual": "^3.14.8",
    "@tldraw/assets": "^5.2.5",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.16.0",
    "lucide-react": "^1.25.0",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.3.0",
    "tldraw": "^5.2.5",
    "vue": "^3.5.40",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vue/compiler-sfc": "^3.5.40",
    "sass": "^1.89.2",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10",
    "vue-loader": "^17.4.2"
  }
}
