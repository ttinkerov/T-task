NODE_ENV=development
# Production Docker: use docker-compose.prod.yml (forces NODE_ENV=production).
# Local Docker with NODE_ENV=development requires ALLOW_INSECURE_DEV=true (set in docker-compose.yml).
# ALLOW_INSECURE_DEV=true

APP_URL=http://localhost:3000
API_URL=http://localhost:3001/api/v1

POSTGRES_USER=ttask
# Dev default only — production MUST set a strong unique password (compose.prod requires it).
POSTGRES_PASSWORD=ttask_secret
POSTGRES_DB=ttask
DATABASE_URL=postgresql://ttask:ttask_secret@postgres:5432/ttask?schema=public&connection_limit=10
DIRECT_DATABASE_URL=postgresql://ttask:ttask_secret@postgres:5432/ttask?schema=public

REDIS_URL=redis://redis:6379
# Production (docker-compose.prod.yml): set a strong password and match REDIS_URL.
# REDIS_PASSWORD=
# REDIS_URL=redis://:YOUR_PASSWORD@redis:6379
UPLOAD_DIR=/app/uploads

BACKEND_PORT=3001
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=GENERATE_WITH_openssl_rand_base64_48_chars_min
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Trust X-Forwarded-For only behind a real reverse proxy that overwrites XFF.
# Local/dev default: false. Production default in code: 1 hop when unset.
# TRUST_PROXY=false
CORS_ORIGIN=http://localhost:3000
# Public site URL for Open Graph / canonical links (no trailing slash).
# APP_URL already set above — keep NEXT_PUBLIC_APP_URL in sync for the frontend.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional SMTP — leave unset to disable outbound email in local/dev
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=T-task <noreply@example.com>

FRONTEND_PORT=3000
# Browser: Socket.IO + CSP. Next proxies /api/* to the rewrite target below.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Server-side fetch + Next.js /api rewrite destination (use Docker DNS in compose).
API_INTERNAL_URL=http://localhost:3001

# Optional: encrypt workspace AI API tokens at rest (base64 32-byte key)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AI_TOKEN_ENC_KEY=

# RAG_EMBEDDING_MODEL=text-embedding-3-small
